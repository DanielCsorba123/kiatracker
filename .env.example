# Copy to .env and fill in. .env is gitignored; never commit real values.

# Pleos Vehicle Data API key (https://document.pleos.ai, Workspace > My Vehicle Data API)
PLEOS_API_KEY_CLIENT_ID=
PLEOS_API_KEY_CLIENT_SECRET=

# Where raw files and the database live (default: ./data)
# KIATRACKER_DATA_DIR=data

# Home location, used only to label drives and charging "home" or "other"
# KIATRACKER_HOME_LAT=
# KIATRACKER_HOME_LON=
# KIATRACKER_HOME_RADIUS_KM=0.3
